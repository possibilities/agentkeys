{
  "name": "agentkeys",
  "version": "0.1.0",
  "description": "Inventory keyboard shortcuts across Karabiner, skhd, Ghostty, tmux, Herdr, and Neovim",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/possibilities/agentkeys.git"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "type": "module",
  "bin": {
    "agentkeys": "src/cli.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
